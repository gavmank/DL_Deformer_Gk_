<?xml version="1.0" encoding="utf-8"?>
<TpsData xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Qt.py</Name>
  <!-- Software Name and Version  -->
<!-- Software Name: Qt.py
    Download Link: https://github.com/mottosso/Qt.py
    Version: 1.4.1
    Notes: This Qt.py file will be included with the source code of our Maya plugin.
It is about the file Qt.py in the github repository, no other files are included.The file will be in this location in the UE5Main stream for example.
Please keep in mind even though the location is in NotForLicensees, it still is being packaged as a UE marketplace package that UE users can download.
        -->
<Location>Engine\Restricted\NotForLicensees\Source\Programs\MayaMLDeformerPlugin\mldeformer\ui</Location>
<Function>This allows us to more easily support different Maya versions for the ML Deformer plugin on the UE Marketplace. </Function>
<Eula>https://github.com/mottosso/Qt.py?tab=MIT-1-ov-file#readme</Eula>
  <RedistributeTo>
    <EndUserGroup>Licensee</EndUserGroup>
    <EndUserGroup>P4</EndUserGroup>
    <EndUserGroup>Git</EndUserGroup>
  </RedistributeTo>
  <LicenseFolder>/Engine/Source/ThirdParty/Licenses</LicenseFolder>
</TpsData>